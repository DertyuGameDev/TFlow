digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Посещение и онлайн-комнаты"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"EventAccessKey" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>EventAccessKey</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Ключ помощника / ведущего (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"CheckIn" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>CheckIn</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Вход на мероприятие</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="checked_by"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">checked_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="access_key"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">access_key_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">EventAccessKey</FONT></TD></TR></TABLE>>];
"ActivityAttendance" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>ActivityAttendance</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Посещение флоу</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="checked_by"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">checked_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="access_key"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">access_key_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">EventAccessKey</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"Webinar" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Webinar</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Комната видеосвязи</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK UQ NULL</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room"><FONT COLOR="#8b6a00"> UQ</FONT></TD><TD ALIGN="LEFT">room</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="active"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT COLOR="#8b6a00"> NULL</FONT></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at"><FONT COLOR="#8b6a00"> NULL</FONT></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"User":e -> "CheckIn":user:w [label="user_id\n1 : 0..N"];
"Event":e -> "CheckIn":event:w [label="event_id\n1 : 0..N"];
"User":e -> "CheckIn":checked_by:w [label="checked_by_id\n0..1 : 0..N"];
"EventAccessKey":e -> "CheckIn":access_key:w [label="access_key_id\n0..1 : 0..N"];
"User":e -> "ActivityAttendance":user:w [label="user_id\n1 : 0..N"];
"Activity":e -> "ActivityAttendance":activity:w [label="activity_id\n1 : 0..N"];
"User":e -> "ActivityAttendance":checked_by:w [label="checked_by_id\n0..1 : 0..N"];
"EventAccessKey":e -> "ActivityAttendance":access_key:w [label="access_key_id\n0..1 : 0..N"];
"Event":e -> "Webinar":event:w [label="event_id\n1 : 0..N"];
"Activity":e -> "Webinar":activity:w [label="activity_id\n0..1 : 0..1"];
}
