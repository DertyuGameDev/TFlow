digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Билеты, записи и листы ожидания"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"EventRegistration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>EventRegistration</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Билет мероприятия</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="profile_data"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">profile_data</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">JSON</FONT></TD></TR></TABLE>>];
"Registration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Registration</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Запись на флоу</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"EventWaitlistEntry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>EventWaitlistEntry</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Очередь мероприятия</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"WaitlistEntry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>WaitlistEntry</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Очередь на флоу</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"User":e -> "EventRegistration":user:w [label="user_id\n1 : 0..N"];
"Event":e -> "EventRegistration":event:w [label="event_id\n1 : 0..N"];
"User":e -> "Registration":user:w [label="user_id\n1 : 0..N"];
"Activity":e -> "Registration":activity:w [label="activity_id\n1 : 0..N"];
"User":e -> "EventWaitlistEntry":user:w [label="user_id\n1 : 0..N"];
"Event":e -> "EventWaitlistEntry":event:w [label="event_id\n1 : 0..N"];
"User":e -> "WaitlistEntry":user:w [label="user_id\n1 : 0..N"];
"Activity":e -> "WaitlistEntry":activity:w [label="activity_id\n1 : 0..N"];
}
