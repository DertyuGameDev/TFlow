digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Делегирование прав организатора"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"EventAccessKey" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>EventAccessKey</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Ключ помощника / ведущего</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">created_by_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_hash"><FONT COLOR="#8b6a00"> UQ</FONT></TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purpose"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="revoked_at"><FONT COLOR="#8b6a00"> NULL</FONT></TD><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"EventAccessUse" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>EventAccessUse</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Использование ключа</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="key"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">key_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">EventAccessKey</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_used_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">last_used_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"Event":e -> "EventAccessKey":event:w [label="event_id\n1 : 0..N"];
"Activity":e -> "EventAccessKey":activity:w [label="activity_id\n0..1 : 0..N"];
"User":e -> "EventAccessKey":created_by:w [label="created_by_id\n0..1 : 0..N"];
"EventAccessKey":e -> "EventAccessUse":key:w [label="key_id\n1 : 0..N"];
"User":e -> "EventAccessUse":user:w [label="user_id\n1 : 0..N"];
}
