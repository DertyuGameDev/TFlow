digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Клубы, подписки и избранное"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Community" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Community</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Клуб</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="topic"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="color"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="owner"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR></TABLE>>];
"Membership" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Membership</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Участие и подписка в клубе</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notify_events"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">notify_events</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="community"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">community_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Community</FONT></TD></TR></TABLE>>];
"CommunityAvatar" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>CommunityAvatar</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Фото клуба</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="community"><FONT COLOR="#8b6a00">FK UQ</FONT></TD><TD ALIGN="LEFT">community_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Community</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Binary</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"Bookmark" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Bookmark</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Избранное</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR></TABLE>>];
"User":e -> "Community":owner:w [label="owner_id\n0..1 : 0..N"];
"User":e -> "Membership":user:w [label="user_id\n1 : 0..N"];
"Community":e -> "Membership":community:w [label="community_id\n1 : 0..N"];
"Community":e -> "CommunityAvatar":community:w [label="community_id\n1 : 0..1"];
"User":e -> "Bookmark":user:w [label="user_id\n1 : 0..N"];
"Event":e -> "Bookmark":event:w [label="event_id\n1 : 0..N"];
}
