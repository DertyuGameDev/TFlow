digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Программа мероприятия"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Community" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Community</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Клуб (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="owner"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">venue</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="format"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">format</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="topic"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cover"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">cover</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="community"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">community_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Community</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">PositiveBigInteger</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="required_profile_fields"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">required_profile_fields</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">JSON</FONT></TD></TR></TABLE>>];
"Room" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Room</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Аудитория</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">PositiveBigInteger</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_online"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">is_online</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Boolean</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Room</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="speaker"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">speaker</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ends_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">PositiveBigInteger</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registration_required"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">registration_required</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"User":e -> "Event":owner:w [label="owner_id\n1 : 0..N"];
"Community":e -> "Event":community:w [label="community_id\n0..1 : 0..N"];
"Event":e -> "Room":event:w [label="event_id\n1 : 0..N"];
"Event":e -> "Activity":event:w [label="event_id\n1 : 0..N"];
"Room":e -> "Activity":room:w [label="room_id\n1 : 0..N"];
}
