digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="ТФлоу | Как устроены данные"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Community" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Community</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Клуб</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR></TABLE>>];
"Room" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Room</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Аудитория</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR></TABLE>>];
"User":e -> "Community":w [label="owner_id\n0..1 : 0..N"];
"User":e -> "Event":w [label="owner_id\n1 : 0..N"];
"Community":e -> "Event":w [label="community_id\n0..1 : 0..N"];
"Event":e -> "Room":w [label="event_id\n1 : 0..N"];
"Event":e -> "Activity":w [label="event_id\n1 : 0..N"];
"Room":e -> "Activity":w [label="room_id\n1 : 0..N"];
}
