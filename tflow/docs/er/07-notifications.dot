digraph ER {
graph [rankdir=LR, bgcolor="#f3f5f7", pad="0.5", nodesep="0.55", ranksep="1.15", splines=spline, outputorder=edgesfirst, fontname="DejaVu Sans", fontsize=24, labelloc=t, label="Уведомления и служебные данные"];
node [shape=plain, fontname="DejaVu Sans", fontsize=13];
edge [fontname="DejaVu Sans", fontsize=11, color="#7f8b9b", fontcolor="#364152", arrowsize=0.6, arrowhead=none];
"User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>User</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Пользователь (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Event" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Event</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Мероприятие (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Activity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Activity</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Флоу / активность (ссылка)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR></TABLE>>];
"Notification" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>Notification</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Уведомление на сайте</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event"><FONT COLOR="#8b6a00">FK NULL</FONT></TD><TD ALIGN="LEFT">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Event</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="message"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="read"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">read</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Boolean</FONT></TD></TR></TABLE>>];
"ActivityReminder" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>ActivityReminder</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Защита от повторных напоминаний</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activity"><FONT COLOR="#8b6a00">FK</FONT></TD><TD ALIGN="LEFT">activity_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Activity</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"UserAvatar" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>UserAvatar</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Фото пользователя</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">BigAuto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user"><FONT COLOR="#8b6a00">FK UQ</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">User</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Binary</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"AuthRateLimit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>AuthRateLimit</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Лимиты попыток входа</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="key"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">PositiveInteger</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT COLOR="#8b6a00"> </FONT></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">DateTime</FONT></TD></TR></TABLE>>];
"ScheduleLock" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#ffdf62"><B>ScheduleLock</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#4b5563">Блокировка расписания</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#8b6a00">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#657080">PositiveSmallInteger</FONT></TD></TR></TABLE>>];
"Activity":e -> "Notification":activity:w [label="activity_id\n0..1 : 0..N"];
"User":e -> "Notification":user:w [label="user_id\n1 : 0..N"];
"Event":e -> "Notification":event:w [label="event_id\n0..1 : 0..N"];
"User":e -> "ActivityReminder":user:w [label="user_id\n1 : 0..N"];
"Activity":e -> "ActivityReminder":activity:w [label="activity_id\n1 : 0..N"];
"User":e -> "UserAvatar":user:w [label="user_id\n1 : 0..1"];
}
