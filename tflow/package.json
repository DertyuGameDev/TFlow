{
  "name": "tflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node scripts/python.mjs manage.py runserver 127.0.0.1:8000",
    "build": "vite build",
    "check": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/python.mjs manage.py runserver 127.0.0.1:5173",
    "test:backend": "node scripts/python.mjs manage.py test flow.tests --noinput",
    "db:migrate": "node scripts/python.mjs manage.py migrate --noinput",
    "test:calendar": "node --experimental-strip-types lib/calendar.test.mjs",
    "setup:video": "node scripts/setup-video.mjs",
    "setup:mail": "node scripts/python.mjs ../scripts/setup-mail.py",
    "test:frontend": "npm run test:calendar && node --experimental-strip-types lib/activities.test.mjs && node --experimental-strip-types lib/screen-share.test.mjs && node --experimental-strip-types lib/audio-level.test.mjs && npm run test:ui",
    "test:ui": "vitest run",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "0.23.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^27.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.5"
  }
}
