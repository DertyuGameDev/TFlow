{
  "name": "tflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node scripts/python.mjs manage.py runserver 127.0.0.1:8000",
    "build": "vite build",
    "check": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/python.mjs manage.py runserver 127.0.0.1:5173",
    "test:backend": "node scripts/python.mjs manage.py test flow.tests --noinput",
    "db:migrate": "node scripts/python.mjs manage.py migrate --noinput"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
