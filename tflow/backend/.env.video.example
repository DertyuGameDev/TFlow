# Production: use a LiveKit server or LiveKit Cloud, with WSS/HTTPS and TURN.
# Copy to backend/.env.video for local custom settings; keep real secrets out of Git.
LIVEKIT_URL=wss://video.example.com
# Optional private RoomService URL when Django and LiveKit share a VM.
# Browsers receive only LIVEKIT_URL, never this internal address.
# LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
