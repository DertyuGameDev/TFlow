# Copy to backend/.env.mail for local development; never commit the real file.
# A dedicated service mailbox can be used instead of a personal mailbox.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# For Yandex this must be the same mailbox as EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
NOTIFICATION_EMAIL_ENABLED=0
TFLOW_PUBLIC_URL=http://localhost:5173
