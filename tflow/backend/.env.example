DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-your-own-random-secret
DJANGO_ALLOWED_HOSTS=tflow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tflow.example.com
# Only behind a trusted reverse proxy that overwrites X-Forwarded-Proto:
DJANGO_TRUST_PROXY=1
# Optional PostgreSQL. Without DATABASE_URL, SQLite is used in backend/data/.
# DATABASE_URL=postgresql://user:password@db:5432/tflow
